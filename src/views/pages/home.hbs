<script>
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('hall-of-fame-cards-container');
        if (!container) return;

        function renderPostersList(posters) {
            if (!Array.isArray(posters) || posters.length === 0) return;
            container.innerHTML = posters.map(p => `
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden bg-white hover-translate">
                        <div class="position-relative bg-light text-center p-3" style="min-height: 250px;">
                            <img src="${p.img || '/images/landingpage1.jpeg'}" alt="${p.title || 'Hall of Fame'}" class="img-fluid rounded-3 shadow-sm object-fit-contain" style="max-height: 260px; width: 100%;">
                        </div>
                        <div class="card-body p-4 border-top">
                            <span class="badge text-white text-uppercase mb-2" style="background-color: #0B3D91 !important; font-size: 9px;"><i class="bi bi-trophy-fill me-1 text-warning"></i> ${p.badge || 'ACADEMIC TOPPER'}</span>
                            <h5 class="fw-bold text-navy mb-2">${p.title || ''}</h5>
                            <p class="text-muted small m-0 leading-relaxed">${p.desc || ''}</p>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        const savedPosters = localStorage.getItem('admin_halloffame_posters');
        if (savedPosters) {
            try {
                const parsed = JSON.parse(savedPosters);
                if (Array.isArray(parsed) && parsed.length > 0) {
                    renderPostersList(parsed);
                }
            } catch(e) {}
        }

        fetch('/api/posters')
            .then(res => res.json())
            .then(data => {
                if (data.success && data.posters && data.posters.length > 0) {
                    renderPostersList(data.posters);
                }
            })
            .catch(() => {});
    });
</script>
