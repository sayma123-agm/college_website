        height: 10px;
        border-radius: 50%;
    }
</style>
<!-- Events & News Section (Matches Official Screenshot Layout) -->
<section class="py-5 position-relative overflow-hidden" style="background-color: #ffffff !important;">
    <div class="container position-relative z-2">
        <div class="text-center mb-5 max-w-600 mx-auto" data-aos="fade-up">
            <span class="badge text-white text-uppercase tracking-wider fw-bold px-3 py-1 mb-2" style="background-color: #0B3D91 !important; font-size: 10px;">
                <i class="bi bi-bell-fill me-1"></i> LATEST UPDATES
            </span>
            <h2 class="display-5 fw-extrabold text-dark mt-1" style="color: #0B3D91 !important; font-family: 'Plus Jakarta Sans', sans-serif;">
                Events & <span style="color: #ffc107 !important;">News</span>
            </h2>
            <p class="text-muted small m-0" style="color: #475569 !important;">Stay updated with the latest happenings, achievements, and announcements from AGMRCET.</p>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Left Card: EVENTS -->
            <div class="col-lg-6" data-aos="fade-right">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white text-dark h-100">
                    <div class="text-white p-3.5 d-flex justify-content-between align-items-center" style="background-color: #0B3D91 !important;">
                        <h5 class="fw-extrabold m-0 text-uppercase tracking-wider fs-6" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                            <i class="bi bi-calendar-event me-2"></i> EVENTS
                        </h5>
                        <span class="text-white-50 fs-5">—</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            {{#if events.length}}
                            {{#each events}}
                            <a href="/news" class="list-group-item p-3.5 border-bottom transition-all hover-bg-light cursor-pointer text-decoration-none d-block">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="date-badge text-white text-center rounded-3 p-2 font-bold leading-tight" style="min-width: 54px; background-color: #0B3D91 !important;">
                                        <span class="fs-5 d-block fw-extrabold">{{this.day}}</span>
                                        <span class="text-xs text-uppercase opacity-90">{{this.month}}</span>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-navy mb-1 leading-snug" style="font-size: 13.5px;">{{this.title}}</h6>
                                        <span class="badge bg-primary text-white text-uppercase" style="font-size: 9px;">{{this.category}}</span>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted"></i>
                                </div>
                            </a>
                            {{/each}}
                            {{else}}
                            <div class="p-4 text-center text-muted small">No upcoming events scheduled.</div>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Card: BULLETIN BOARD -->
            <div class="col-lg-6" data-aos="fade-left">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white text-dark h-100">
                    <div class="text-white p-3.5 d-flex justify-content-between align-items-center" style="background-color: #0B3D91 !important;">
                        <h5 class="fw-extrabold m-0 text-uppercase tracking-wider fs-6" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                            <i class="bi bi-journal-text me-2"></i> BULLETIN BOARD
                        </h5>
                        <span class="text-white-50 fs-5">—</span>
                    </div>
                    <div class="card-body p-4">
                        {{#if bulletins.length}}
                        <ul class="list-unstyled space-y-3.5 m-0" style="font-size: 13.5px;">
                            {{#each bulletins}}
                            <li class="d-flex align-items-start gap-2.5 pb-3 border-bottom">
                                <span class="rounded-circle mt-1.5" style="width: 8px; height: 8px; min-width: 8px; background-color: #0B3D91 !important;"></span>
                                <div class="flex-grow-1">
                                    <a href="/news" class="text-navy fw-bold m-0 leading-relaxed text-decoration-none hover-text-danger">{{this.title}}</a>
                                    <span class="badge bg-light text-dark border ms-1 font-mono" style="font-size: 8px;">{{this.category}}</span>
                                </div>
                                <i class="bi bi-chevron-right text-muted small mt-1"></i>
                            </li>
                            {{/each}}
                        </ul>
                        {{else}}
                        <div class="text-center text-muted small">No recent announcements found.</div>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Center CTA Button -->
        <div class="text-center mt-5 mb-5" data-aos="fade-up">
            <a href="/news" class="btn btn-danger btn-lg px-5 py-3 rounded-pill fw-bold text-uppercase tracking-wider shadow-lg hover-translate" style="background-color: #0B3D91 !important; border-color: #0B3D91 !important; font-size: 13px;">
                View More News & Events <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>
