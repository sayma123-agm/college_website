            if (mainUsn) mainUsn.value = usnVal;
            if (mainPwd) mainPwd.value = pwdVal;
            
            // Execute login trigger via main submit button
            if (mainSubmit) mainSubmit.click();
        });
    }

    const mediaForm = document.getElementById("media-login-form");
    if (mediaForm) {
        mediaForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const usnVal = document.getElementById("media-usn").value.trim();
            const pwdVal = document.getElementById("media-password").value;
            
            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: usnVal, password: pwdVal, expectedRole: 'admin' })
                });

                const data = await res.json();
                if (data.success && data.token) {
                    localStorage.setItem('adminToken', data.token);
                    localStorage.setItem('adminName', data.name || 'System Admin');
                    window.location.href = '/admin/dashboard';
                } else {
                    const errBox = document.getElementById('login-error-alert');
                    if (errBox) {
                        errBox.innerText = data.message || 'Media admin authentication failed.';
                        errBox.classList.remove('d-none');
                    }
                }
            } catch (err) {
                alert('Network connection error.');
            }
        });
    }

    // Intercept switchPortalGateway presets to populate our visible inputs
    const originalSwitch = window.switchPortalGateway;
    window.switchPortalGateway = (role) => {
        if (typeof originalSwitch === 'function') {
            originalSwitch(role);
        }
        
        // Sync presets to the visible inputs
        const currentUsn = mainUsn ? mainUsn.value : '';
        const currentPwd = mainPwd ? mainPwd.value : '';
        
        const studentUsn = document.getElementById("student-usn");
        const studentPwd = document.getElementById("student-password");
        const employeeUsn = document.getElementById("employee-usn");
        const employeePwd = document.getElementById("employee-password");

        if (role === 'student') {
            if (studentUsn) studentUsn.value = currentUsn;
            if (studentPwd) studentPwd.value = currentPwd;
        } else {
            if (employeeUsn) employeeUsn.value = currentUsn;
            if (employeePwd) employeePwd.value = currentPwd;
        }
    };
    
    // Auto-run initial prefill once portal.js is loaded
    setTimeout(() => {
        const pathParts = window.location.pathname.split('/');
        const urlRole = pathParts[pathParts.length - 1];
        const defaultRole = ['student', 'faculty', 'hod', 'office', 'fee', 'principal', 'admin', 'broadcast', 'tpo'].includes(urlRole) ? urlRole : 'student';
        window.switchPortalGateway(defaultRole);
    }, 200);

    // Live Digital Clock & Calendar Ticker
    function updateClock() {
        const timeEl = document.getElementById("portal-live-time");
        const dateEl = document.getElementById("portal-live-date");
        if (!timeEl || !dateEl) return;

        const now = new Date();
        
        // Time/date formatting
        let hours = now.getHours();
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');
        const ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12;
        hours = hours ? hours : 12; 
        const hoursStr = String(hours).padStart(2, '0');
        timeEl.textContent = `${hoursStr}:${minutes}:${seconds} ${ampm}`;

        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        dateEl.textContent = now.toLocaleDateString('en-US', options);
    }
    
    updateClock();
    setInterval(updateClock, 1000);
});
</script>
