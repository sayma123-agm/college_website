<!-- Change Password Modal -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 glassmorphism shadow-2xl">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-navy text-uppercase tracking-wider" id="forgotPasswordModalLabel"><i class="bi bi-key-fill text-primary me-2"></i>Change ERP Password</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <form id="forgot-password-form" onsubmit="event.preventDefault(); if(typeof window.handleChangePassword === 'function') window.handleChangePassword(event);">
                    <div class="mb-3">
                        <label for="current-password" class="form-label small fw-bold text-navy mb-1">Current Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            <input type="password" class="form-control shadow-none rounded-end-2 border-start-0 bg-light" id="current-password" placeholder="Enter current password" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="new-password" class="form-label small fw-bold text-navy mb-1">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-lock text-muted"></i></span>
                            <input type="password" class="form-control shadow-none rounded-end-2 border-start-0 bg-light" id="new-password" placeholder="Enter new password" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="confirm-new-password" class="form-label small fw-bold text-navy mb-1">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-check2-circle text-muted"></i></span>
                            <input type="password" class="form-control shadow-none rounded-end-2 border-start-0 bg-light" id="confirm-new-password" placeholder="Confirm new password" required>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2.5 text-uppercase tracking-wider fw-bold small rounded-2 mt-2" style="background: linear-gradient(135deg, var(--secondary-color), var(--primary-color)) !important;">
                        Update Password <i class="bi bi-check-circle ms-1"></i>
                    </button>
                </form>
                <div id="reset-success-alert" class="alert alert-success d-none mt-3 small py-2 px-3 text-center" role="alert">
                    Password updated successfully!
                </div>
            </div>
        </div>
    </div>
</div>

