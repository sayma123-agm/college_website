<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Media Admin Dashboard | AGMRCET</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F8FAFC;
            color: #1E293B;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* Vibrant Colored Watermark Backgrounds */
        .admin-watermark-left {
            position: fixed;
            left: -30px;
            top: 55%;
            transform: translateY(-50%) rotate(-10deg);
            width: 340px;
            height: 340px;
            opacity: 0.18;
            pointer-events: none;
            user-select: none;
            z-index: 1;
        }

        .admin-watermark-right {
            position: fixed;
            right: -30px;
            top: 55%;
            transform: translateY(-50%) rotate(10deg);
            width: 340px;
            height: 340px;
            opacity: 0.18;
            pointer-events: none;
            user-select: none;
            z-index: 1;
        }

        body::before {
            content: "";
            position: fixed;
            top: 55%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 520px;
            height: 520px;
            pointer-events: none;
            z-index: 0;
            background-image: url("/images/logo.png");
            background-repeat: no-repeat;
            background-position: center;
            background-size: contain;
            opacity: 0.12;
        }

        /* Direct Inline Editable Text Styles */
        [contenteditable="true"] {
            outline: 1px dashed rgba(11, 61, 145, 0.4);
            outline-offset: 3px;
            border-radius: 4px;
            cursor: text;
            transition: all 0.2s ease;
        }
        [contenteditable="true"]:hover {
            outline: 2px dashed #0B3D91;
            background-color: rgba(11, 61, 145, 0.04);
        }
        [contenteditable="true"]:focus {
            outline: 2px solid #0B3D91;
            background-color: #ffffff;
            box-shadow: 0 0 8px rgba(11, 61, 145, 0.2);
        }

        /* Standalone Admin Top Navigation Bar */
        .admin-top-header {
            background: linear-gradient(135deg, #0B3D91 0%, #051D40 100%) !important;
            border-bottom: 3px solid #ffc107;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            position: relative;
            z-index: 10;
        }

        .admin-brand-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 19px;
            color: #ffffff;
            line-height: 1.15;
            letter-spacing: -0.2px;
        }

        /* Modern Dashboard Cards */
        .admin-card {
            background: #ffffff;
            border: 1px solid rgba(15, 23, 42, 0.08);
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
            transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
            position: relative;
            z-index: 2;
        }

        .admin-card:hover {
            box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
        }

        /* Metric Summary Widget Cards */
        .metric-card {
            background: #ffffff;
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            padding: 1.25rem;
            transition: all 0.2s ease;
        }
        .metric-card:hover {
            transform: translateY(-3px);
            border-color: #CBD5E1;
            box-shadow: 0 8px 20px rgba(0,0,0,0.04);
        }

        /* Nav Pills Styling */
        .nav-pills .nav-link {
            color: #475569;
            background: #ffffff;
            border: 1px solid #E2E8F0;
            font-weight: 700;
            font-size: 13px;
            padding: 10px 24px;
            border-radius: 30px;
            transition: all 0.25s ease;
        }

        .nav-pills .nav-link:hover {
            border-color: #94A3B8;
            color: #0F172A;
            background-color: #F8FAFC;
        }

        .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #0B3D91 0%, #1E40AF 100%) !important;
            color: #ffffff !important;
            border-color: #0B3D91 !important;
            box-shadow: 0 6px 16px rgba(11, 61, 145, 0.25);
        }

        /* Bulletin Card Category Accent Colors */
        .bulletin-card-circular { border-left: 4px solid #0d6efd !important; }
        .bulletin-card-event { border-left: 4px solid #6f42c1 !important; }
        .bulletin-card-admissions { border-left: 4px solid #ffc107 !important; }
        .bulletin-card-placement { border-left: 4px solid #198754 !important; }

        .topper-poster-img {
            max-height: 250px;
            width: 100%;
            object-fit: contain;
            background-color: #F1F5F9;
            border-radius: 12px;
            transition: transform 0.3s ease;
        }
        .topper-poster-img:hover {
            transform: scale(1.02);
        }

        .inquiry-card {
            border-left: 4px solid #0B3D91;
            transition: all 0.2s ease;
        }
        .inquiry-card:hover {
            box-shadow: 0 8px 24px rgba(11, 61, 145, 0.08) !important;
        }
    </style>
</head>
<body>

    <!-- Standalone Dedicated Executive Admin Header (NO public navbar) -->
    <header class="admin-top-header py-3 px-3 px-md-4 text-white">
        <div class="container-fluid d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <img src="/images/logo.png" alt="AGMRCET Logo" style="width: 48px; height: 48px; object-fit: contain;">
                <div>
                    <div class="admin-brand-title">AGMRCET Media & Advertisements Dashboard</div>
                    <div class="d-flex align-items-center gap-2 mt-0.5" style="font-size: 11px;">
                        <span class="text-white-75">Authorized Administrative Management Console</span>
                        <span class="text-white-30">•</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5" style="font-size: 9.5px;">
                            <span class="spinner-grow spinner-grow-sm text-success me-1" style="width: 5px; height: 5px;"></span> LIVE CONSOLE ONLINE
                        </span>
                    </div>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-md-flex align-items-center gap-2 border-end pe-3 border-white-20">
                    <div class="rounded-circle bg-white text-navy d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 13px; color: #0B3D91;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <div class="small text-white fw-bold" id="admin-user-display">System Admin Coordinator</div>
                        <span class="badge bg-warning text-dark font-mono fw-bold" style="font-size: 9.5px;">AGM-ADMIN-999</span>
                    </div>
                </div>
                <button id="admin-logout-btn" onclick="adminSignOut()" class="btn btn-outline-light btn-sm rounded-pill px-3 py-1.5 fw-bold d-flex align-items-center gap-1.5 shadow-xs" style="font-size: 12px; cursor: pointer; position: relative; z-index: 100;">
                    <i class="bi bi-box-arrow-right"></i> Sign Out
                </button>
            </div>
        </div>
    </header>

    <!-- Main Console Viewport -->
    <main class="flex-grow-1 py-4 px-2 px-md-4 position-relative z-2">
        <!-- Floating Vibrant Colored Watermark Logos -->
        <div class="admin-watermark-left d-none d-xl-block">
            <img src="/images/logo.png" alt="Left Watermark Logo" class="w-100 h-100 object-fit-contain">
        </div>
        <div class="admin-watermark-right d-none d-xl-block">
            <img src="/images/logo.png" alt="Right Watermark Logo" class="w-100 h-100 object-fit-contain">
        </div>

        <div class="container-fluid position-relative z-2">
            
            <!-- Top Summary Analytics Widgets Row -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="metric-card d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2.5 bg-primary-subtle text-primary fs-4 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; min-width: 46px;">
                            <i class="bi bi-megaphone-fill"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Live Updates</div>
                            <h5 class="fw-extrabold m-0 text-navy" id="stat-bulletins-count">0 Items</h5>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="metric-card d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2.5 bg-warning-subtle text-warning-emphasis fs-4 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; min-width: 46px;">
                            <i class="bi bi-envelope-paper-fill"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Student Inquiries</div>
                            <h5 class="fw-extrabold m-0 text-navy" id="stat-inquiries-count">0 Submitted</h5>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="metric-card d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2.5 bg-purple-subtle text-purple fs-4 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; min-width: 46px; background-color: #F3E8FF; color: #7E22CE;">
                            <i class="bi bi-trophy-fill"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Hall of Fame</div>
                            <h5 class="fw-extrabold m-0 text-navy">3 Posters</h5>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="metric-card d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2.5 bg-success-subtle text-success fs-4 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; min-width: 46px;">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Console Security</div>
                            <h5 class="fw-extrabold m-0 text-success fs-6">JWT Protected</h5>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dashboard Sub-Navigation Tabs -->
            <ul class="nav nav-pills mb-4 gap-2 justify-content-start" id="adminTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active d-flex align-items-center gap-2" id="btn-tab-bulletins" onclick="switchAdminTab('bulletins-panel', this)">
                        <i class="bi bi-megaphone-fill"></i> Manage Live Updates
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link d-flex align-items-center gap-2" id="btn-tab-halloffame" onclick="switchAdminTab('halloffame-panel', this)">
                        <i class="bi bi-trophy-fill text-warning"></i> Hall of Fame & Toppers
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link d-flex align-items-center gap-2" id="btn-tab-inquiries" onclick="switchAdminTab('inquiries-panel', this)">
                        <i class="bi bi-envelope-paper-fill text-warning"></i> Student Inquiries <span id="inquiries-counter" class="badge bg-danger ms-1" style="font-size: 9.5px;">0</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link d-flex align-items-center gap-2" id="btn-tab-calendar" onclick="switchAdminTab('calendar-panel', this)">
                        <i class="bi bi-calendar-event-fill text-warning"></i> Academic Calendar <span id="calendar-counter" class="badge bg-primary ms-1" style="font-size: 9.5px;">6</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link d-flex align-items-center gap-2" id="btn-tab-admission-modal" onclick="switchAdminTab('admission-modal-panel', this)">
                        <i class="bi bi-badge-ad-fill text-danger"></i> Admission Ad Popup
                    </button>
                </li>
            </ul>

            <!-- Tab Content Panels -->
            <div class="tab-content" id="adminTabsContent">
                
                <!-- Tab 1: Manage Live Updates -->
                <div class="tab-pane fade show active" id="bulletins-panel" role="tabpanel" style="display: block;">
                    <div class="row g-4">
                        <!-- Add Form Card -->
                        <div class="col-lg-4">
                            <div class="admin-card p-4">
                                <h5 class="fw-extrabold text-navy mb-3" style="font-family: 'Plus Jakarta Sans', sans-serif;"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Publish Daily Update</h5>
                                <div id="form-alert" class="alert d-none small"></div>
                                
                                <form id="add-news-form">
                                    <div class="mb-3">
                                        <label for="news-category" class="form-label small fw-bold text-navy"><i class="bi bi-tags me-1 text-primary"></i>Category / Channel</label>
                                        <select class="form-select shadow-none rounded-3 py-2 px-3 small" id="news-category" required>
                                            <option value="circular" selected>Circular (Academic/VTU)</option>
                                            <option value="event">Event (Agratha/Fests/Workshops)</option>
                                            <option value="admissions">Admissions & Intake</option>
                                            <option value="placement">Placement & Recruiter Drives</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label for="news-title" class="form-label small fw-bold text-navy"><i class="bi bi-type-h1 me-1 text-primary"></i>Alert Title</label>
                                        <input type="text" class="form-control shadow-none rounded-3 py-2 px-3 small" id="news-title" placeholder="Short description heading" required>
                                    </div>
                                    <div class="mb-4">
                                        <label for="news-content" class="form-label small fw-bold text-navy"><i class="bi bi-text-paragraph me-1 text-primary"></i>Bulletin Content Details</label>
                                        <textarea class="form-control shadow-none rounded-3 py-2 px-3 small" id="news-content" rows="4" placeholder="Detailed notification content visible to public..." required></textarea>
                                    </div>
                                    <button type="submit" id="btn-publish" class="btn btn-primary w-100 py-2.5 rounded-3 fw-bold text-uppercase tracking-wider small shadow-sm d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #0B3D91 0%, #1E40AF 100%) !important; border: none;">
                                        Publish Live Bulletin <i class="bi bi-send-fill fs-6"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Live Bulletins Feed Card -->
                        <div class="col-lg-8">
                            <div class="admin-card p-4">
                                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <h5 class="fw-extrabold text-navy m-0" style="font-family: 'Plus Jakarta Sans', sans-serif;"><i class="bi bi-list-stars text-success me-2"></i>Live Bulletin Feeds</h5>
                                        <span id="bulletins-count" class="badge bg-success-subtle text-success border px-3 py-1.5 rounded-pill small">0 Items</span>
                                    </div>
                                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1" onclick="loadNews()"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</button>
                                </div>

                                <div id="bulletins-list-container" class="d-flex flex-column gap-3">
                                    <div class="text-center py-5 text-muted">Loading active announcements...</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab 2: Hall of Fame & Toppers Showcase -->
                <div class="tab-pane fade" id="halloffame-panel" role="tabpanel" style="display: none;">
                    <div class="admin-card p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                            <div>
                                <h5 class="fw-extrabold text-navy m-0" style="font-family: 'Plus Jakarta Sans', sans-serif;"><i class="bi bi-award-fill text-warning me-2"></i>Hall of Fame & Academic Excellence Showcase</h5>
                                <p class="text-muted small m-0 mt-1">Manage semester rank toppers and national competition winners displayed on the homepage.</p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span id="poster-count-badge" class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold" style="font-size: 11px;">3 Published Posters</span>
                                <button onclick="addNewPosterCard()" class="btn btn-outline-primary rounded-pill fw-bold px-3 py-1.5 shadow-sm small d-flex align-items-center gap-1"><i class="bi bi-plus-lg"></i> Add New Poster</button>
                                <button onclick="saveAllPosters()" class="btn btn-success rounded-pill fw-bold text-white px-3.5 py-1.5 shadow-sm small d-flex align-items-center gap-1.5" style="background-color: #166534; border-color: #166534;"><i class="bi bi-floppy-fill"></i> Save Showcase Posters</button>
                            </div>
                        </div>
                        <div id="poster-save-alert" class="alert d-none small mb-4"></div>

                        <div class="row g-4" id="halloffame-posters-container">
                            <!-- Poster 1: 5th Sem Toppers -->
                            <div class="col-lg-4 col-md-6" id="poster-card-col-1">
                                <div class="card h-100 border rounded-4 overflow-hidden shadow-xs hover-translate">
                                    <div class="p-3 bg-light text-center position-relative cursor-pointer" onclick="triggerPosterUpload(1)" title="Click to Change Poster Image">
                                        <img src="/images/landingpage1.jpeg" id="poster-img-1" alt="5th Sem Toppers" class="topper-poster-img">
                                        <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 start-50 translate-middle-x mb-4 px-2 py-1 small rounded-pill" style="font-size: 9px;"><i class="bi bi-camera-fill me-1"></i> Change Image</span>
                                        <input type="file" id="poster-file-1" accept="image/*" class="d-none" onchange="handlePosterImageUpload(1, this)">
                                    </div>
                                    <div class="card-body p-3 border-top d-flex flex-column">
                                        <span class="badge text-white text-uppercase mb-2 align-self-start" id="poster-badge-1" contenteditable="true" style="background-color: #0B3D91; font-size: 9px;"><i class="bi bi-trophy-fill me-1 text-warning"></i> CSE (AI & ML) • 5th Sem</span>
                                        <h6 class="fw-bold mb-1 text-navy" id="poster-title-1" contenteditable="true" title="Click directly to edit text">5th Semester Toppers [2025-26]</h6>
                                        <p class="text-muted small mb-3 leading-relaxed" id="poster-desc-1" contenteditable="true" title="Click directly to edit text">Mr. Mohammad Rumman Khan, Ms. Barigala Kavya, Ms. Bhavani Dengi, Ms. Tasbiha Desai.</p>
                                        <div class="d-flex gap-2 mt-auto">
                                            <button onclick="triggerPosterUpload(1)" class="btn btn-primary btn-sm rounded-pill py-1 px-3 w-100 fw-bold" style="font-size: 11px; background-color: #0B3D91; border-color: #0B3D91;"><i class="bi bi-image me-1"></i> Change Image</button>
                                            <button onclick="openEditPosterModal(1)" class="btn btn-outline-primary btn-sm rounded-pill py-1 px-2 fw-bold" style="font-size: 11px;" title="Edit via Form"><i class="bi bi-pencil-square"></i></button>
                                            <button onclick="deletePosterCard(1)" class="btn btn-outline-danger btn-sm rounded-pill py-1 px-2 fw-bold" style="font-size: 11px;" title="Delete Poster"><i class="bi bi-trash-fill"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Poster 2: 3rd Sem Toppers -->
                            <div class="col-lg-4 col-md-6" id="poster-card-col-2">
                                <div class="card h-100 border rounded-4 overflow-hidden shadow-xs hover-translate">
                                    <div class="p-3 bg-light text-center position-relative cursor-pointer" onclick="triggerPosterUpload(2)" title="Click to Change Poster Image">
                                        <img src="/images/landingpage2.png" id="poster-img-2" alt="3rd Sem Toppers" class="topper-poster-img">
                                        <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 start-50 translate-middle-x mb-4 px-2 py-1 small rounded-pill" style="font-size: 9px;"><i class="bi bi-camera-fill me-1"></i> Change Image</span>
                                        <input type="file" id="poster-file-2" accept="image/*" class="d-none" onchange="handlePosterImageUpload(2, this)">
                                    </div>
                                    <div class="card-body p-3 border-top d-flex flex-column">
                                        <span class="badge text-white text-uppercase mb-2 align-self-start" id="poster-badge-2" contenteditable="true" style="background-color: #0B3D91; font-size: 9px;"><i class="bi bi-trophy-fill me-1 text-warning"></i> CSE (AI & ML) • 3rd Sem</span>
                                        <h6 class="fw-bold mb-1 text-navy" id="poster-title-2" contenteditable="true" title="Click directly to edit text">3rd Semester Toppers [2025-26]</h6>
                                        <p class="text-muted small mb-3 leading-relaxed" id="poster-desc-2" contenteditable="true" title="Click directly to edit text">Recognizing exemplary academic dedication and university semester ranks.</p>
                                        <div class="d-flex gap-2 mt-auto">
                                            <button onclick="triggerPosterUpload(2)" class="btn btn-primary btn-sm rounded-pill py-1 px-3 w-100 fw-bold" style="font-size: 11px; background-color: #0B3D91; border-color: #0B3D91;"><i class="bi bi-image me-1"></i> Change Image</button>
                                            <button onclick="openEditPosterModal(2)" class="btn btn-outline-primary btn-sm rounded-pill py-1 px-2 fw-bold" style="font-size: 11px;" title="Edit via Form"><i class="bi bi-pencil-square"></i></button>
                                            <button onclick="deletePosterCard(2)" class="btn btn-outline-danger btn-sm rounded-pill py-1 px-2 fw-bold" style="font-size: 11px;" title="Delete Poster"><i class="bi bi-trash-fill"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Poster 3: Hackathon Winners -->
                            <div class="col-lg-4 col-md-6" id="poster-card-col-3">
                                <div class="card h-100 border rounded-4 overflow-hidden shadow-xs hover-translate">
                                    <div class="p-3 bg-light text-center position-relative cursor-pointer" onclick="triggerPosterUpload(3)" title="Click to Change Poster Image">
                                        <img src="/images/image.png" id="poster-img-3" alt="Hackathon Winners" class="topper-poster-img">
                                        <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 start-50 translate-middle-x mb-4 px-2 py-1 small rounded-pill" style="font-size: 9px;"><i class="bi bi-camera-fill me-1"></i> Change Image</span>
                                        <input type="file" id="poster-file-3" accept="image/*" class="d-none" onchange="handlePosterImageUpload(3, this)">
                                    </div>
                                    <div class="card-body p-3 border-top d-flex flex-column">
                                        <span class="badge bg-success text-white text-uppercase mb-2 align-self-start" id="poster-badge-3" contenteditable="true" style="font-size: 9px;"><i class="bi bi-award-fill me-1"></i> Student Innovation Victory</span>
