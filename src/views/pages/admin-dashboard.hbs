        function loadAdmissionBanner() {
            function populateForm(b) {
                if (!b) return;
                const enEl = document.getElementById('ad-banner-enabled');
                const badgeEl = document.getElementById('ad-banner-badge');
                const titleEl = document.getElementById('ad-banner-title');
                const imgEl = document.getElementById('ad-banner-image');
                const phoneEl = document.getElementById('ad-banner-phone');
                const emailEl = document.getElementById('ad-banner-email');
                const cetEl = document.getElementById('ad-banner-cet');
                const comedkEl = document.getElementById('ad-banner-comedk');
                const mbaEl = document.getElementById('ad-banner-mba');
                const mcaEl = document.getElementById('ad-banner-mca');
                const locEl = document.getElementById('ad-banner-location');
                const applyEl = document.getElementById('ad-banner-apply');

                if (enEl) enEl.checked = b.enabled !== false;
                if (b.badgeText && badgeEl) badgeEl.value = b.badgeText;
                if (b.title && titleEl) titleEl.value = b.title;
                if (b.image && imgEl) imgEl.value = b.image;
                if (b.phone && phoneEl) phoneEl.value = b.phone;
                if (b.email && emailEl) emailEl.value = b.email;
                if (b.cetCode && cetEl) cetEl.value = b.cetCode;
                if (b.comedkCode && comedkEl) comedkEl.value = b.comedkCode;
                if (b.mbaCode && mbaEl) mbaEl.value = b.mbaCode;
                if (b.mcaCode && mcaEl) mcaEl.value = b.mcaCode;
                if (b.location && locEl) locEl.value = b.location;
                if (b.applyLink && applyEl) applyEl.value = b.applyLink;

                updateAdMockupLive();
            }

            const saved = localStorage.getItem('admin_admission_banner');
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    populateForm(parsed);
                } catch(e) {}
            }

            fetch('/api/admission-banner')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.banner) {
                        populateForm(data.banner);
                    }
                })
                .catch(() => {});
        }

