                        </div>
                    </div>

                    <h3>Official Student Admission Inquiries Listing</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Ref #</th>
                                <th>Student Name</th>
                                <th>Email Address</th>
                                <th>Contact Phone</th>
                                <th>Course / Program</th>
                                <th>Inquiry Message Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            \${rowsHTML}
