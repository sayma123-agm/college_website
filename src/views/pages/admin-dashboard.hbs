                    <td><strong>${i.name || ''}</strong></td>
                    <td>${i.email || ''}</td>
                    <td>${i.phone || 'N/A'}</td>
                    <td><span class="badge">${i.course || 'General Admission'}</span></td>
                    <td>${i.message || 'N/A'}</td>
                </tr>
            `).join('');

            printWindow.document.write(\`
                <!DOCTYPE html>
