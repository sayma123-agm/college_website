            const titleEl = document.getElementById('ad-banner-title');
            const imgEl = document.getElementById('ad-banner-image');
            const phoneEl = document.getElementById('ad-banner-phone');
            const emailEl = document.getElementById('ad-banner-email');
            const cetEl = document.getElementById('ad-banner-cet');
            const comedkEl = document.getElementById('ad-banner-comedk');
            const mbaEl = document.getElementById('ad-banner-mba');
            const mcaEl = document.getElementById('ad-banner-mca');
            const locEl = document.getElementById('ad-banner-location');
            const applyEl = document.getElementById('ad-banner-apply');

            const badge = badgeEl ? badgeEl.value : 'SDM JAINMATT TRUST';
            const title = titleEl ? titleEl.value : '🔥 ADMISSIONS OPEN 2026-2027';
            const image = imgEl ? imgEl.value : '/images/admission-banner.png';
            const phone = phoneEl ? phoneEl.value : '+91 94810 87999';
            const email = emailEl ? emailEl.value : 'principal@agmrcet.ac.in';
            const cet = cetEl ? cetEl.value : 'E199';
            const comedk = comedkEl ? comedkEl.value : 'E208';
            const mba = mbaEl ? mbaEl.value : 'B401';
            const mca = mcaEl ? mcaEl.value : 'C620';
            const location = locEl ? locEl.value : 'Varur - Hubballi, Karnataka';
            const applyLink = applyEl ? applyEl.value : '/admissions';

            const prevBadge = document.getElementById('prev-modal-badge');
            const prevTitle = document.getElementById('prev-modal-title');
            const prevImg = document.getElementById('prev-modal-img');
            const prevPhone = document.getElementById('prev-modal-phone');
            const prevEmail = document.getElementById('prev-modal-email');
            const prevCet = document.getElementById('prev-modal-cet');
            const prevComedk = document.getElementById('prev-modal-comedk');
            const prevMba = document.getElementById('prev-modal-mba');
            const prevMca = document.getElementById('prev-modal-mca');
            const prevLoc = document.getElementById('prev-modal-loc');
            const prevCallBtn = document.getElementById('prev-modal-call-btn');
            const prevApplyBtn = document.getElementById('prev-modal-apply-btn');

            if (prevBadge) prevBadge.innerText = badge;
            if (prevTitle) prevTitle.innerText = title.replace(/^🔥\s*/, '');
            if (prevImg) prevImg.src = image || '/images/admission-banner.png';
            if (prevPhone) {
                prevPhone.innerText = phone;
                prevPhone.href = 'tel:' + phone.replace(/\s+/g, '');
            }
            if (prevEmail) prevEmail.innerText = '| ' + email;
            if (prevCet) prevCet.innerText = 'CET: ' + cet;
            if (prevComedk) prevComedk.innerText = 'COMEDK: ' + comedk;
            if (prevMba) prevMba.innerText = 'MBA: ' + mba;
            if (prevMca) prevMca.innerText = 'MCA: ' + mca;
            if (prevLoc) prevLoc.innerText = location;
            if (prevCallBtn) prevCallBtn.href = 'tel:' + phone.replace(/\s+/g, '');
            if (prevApplyBtn) prevApplyBtn.href = applyLink || '/admissions';

            if (window.bootstrap && window.bootstrap.Modal) {
                const modalObj = bootstrap.Modal.getOrCreateInstance(modalEl);
                modalObj.show();
            }
        }

        window.deleteNews = deleteNews;
        window.deleteInquiry = deleteInquiry;
        window.loadNews = loadNews;
        window.loadInquiries = loadInquiries;
        window.loadAcademicCalendar = loadAcademicCalendar;
        window.deleteAcademicEvent = deleteAcademicEvent;
        window.filterInquiries = filterInquiries;
        window.openEditNewsModal = openEditNewsModal;
        window.closeEditNewsModal = closeEditNewsModal;
        window.autoSaveBulletin = autoSaveBulletin;
        window.openEditPosterModal = openEditPosterModal;
        window.triggerPosterUpload = triggerPosterUpload;
        window.handlePosterImageUpload = handlePosterImageUpload;
        window.addNewPosterCard = addNewPosterCard;
        window.deletePosterCard = deletePosterCard;
        window.saveAllPosters = saveAllPosters;
        window.loadPosters = loadPosters;
        window.exportInquiriesCSV = exportInquiriesCSV;
        window.exportInquiriesPDF = exportInquiriesPDF;
        window.loadAdmissionBanner = loadAdmissionBanner;
        window.saveAdmissionBannerSettings = saveAdmissionBannerSettings;
        window.handleAdBannerImageUpload = handleAdBannerImageUpload;
        window.updateAdMockupLive = updateAdMockupLive;
        window.previewAdmissionModalDirectly = previewAdmissionModalDirectly;
    </script>
</body>
