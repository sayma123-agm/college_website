            try {
                const res = await fetch('/api/academic-calendar');
                const data = await res.json();

                if (data.success && data.events) {
                    if (counter) counter.innerText = data.events.length;

                    if (data.events.length === 0) {
                        container.innerHTML = '<div class="text-center py-4 text-muted">No academic events scheduled.</div>';
                        return;
                    }

                    container.innerHTML = `
