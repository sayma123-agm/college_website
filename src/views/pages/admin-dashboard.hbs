        async function saveAllPosters() {
            const container = document.getElementById('halloffame-posters-container');
            const alertBox = document.getElementById('poster-save-alert');
            if (!container) return;

            const cards = container.querySelectorAll('.card');
            const postersData = [];

            cards.forEach((card, idx) => {
                const imgEl = card.querySelector('.topper-poster-img');
                const titleEl = card.querySelector('h6');
                const descEl = card.querySelector('p');
                const badgeEl = card.querySelector('.badge');

                postersData.push({
                    id: idx + 1,
                    img: imgEl ? imgEl.getAttribute('src') : '',
                    title: titleEl ? titleEl.innerText.trim() : '',
                    desc: descEl ? descEl.innerText.trim() : '',
                    badge: badgeEl ? badgeEl.innerText.trim() : ''
                });
            });

            localStorage.setItem('admin_halloffame_posters', JSON.stringify(postersData));

            try {
                const res = await fetch('/api/posters', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ posters: postersData })
                });

                const data = await res.json();
                if (alertBox) {
                    alertBox.className = 'alert alert-success small mb-4';
                    alertBox.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> All Hall of Fame topper posters have been saved & published live to the website successfully!';
                    setTimeout(() => { alertBox.className = 'alert d-none small mb-4'; }, 4000);
                }
            } catch (err) {
                if (alertBox) {
                    alertBox.className = 'alert alert-success small mb-4';
                    alertBox.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> All Hall of Fame topper posters saved locally successfully!';
                    setTimeout(() => { alertBox.className = 'alert d-none small mb-4'; }, 4000);
                }
            }
        }

