<!-- Page Header Banner -->
<section class="page-header position-relative overflow-hidden py-5 bg-navy text-white d-flex align-items-center" style="min-height: 220px;">
    <div class="container position-relative z-2 pt-4">
        <div class="row">
            <div class="col-12" data-aos="fade-right">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2 text-white-50">
                        <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Feedback</li>
                    </ol>
                </nav>
                <h1 class="display-5 fw-extrabold m-0" style="font-family: 'Plus Jakarta Sans', sans-serif;">Feedback Portal</h1>
                <p class="text-white-50 small m-0 mt-1">We value your suggestions and feedback to continuously improve our institutional quality.</p>
            </div>
        </div>
    </div>
    <div class="page-header-glow"></div>
</section>

<!-- Feedback Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8" data-aos="fade-up">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white border border-light-subtle">
                    <span class="text-primary text-uppercase tracking-wider fw-bold small">Institutional Feedback</span>
                    <h3 class="fw-bold text-navy mt-1 mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">Submit Your Feedback</h3>
                    
                    <form action="javascript:void(0);" onsubmit="alert('Thank you for your valuable feedback! It has been submitted to the IQAC cell.'); this.reset();" class="d-flex flex-column gap-3">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="feedback-name" class="form-label fw-bold text-navy">Full Name</label>
                                <input type="text" class="form-control rounded-3 py-2.5" id="feedback-name" placeholder="Enter your name" required>
                            </div>
                            <div class="col-md-6">
                                <label for="feedback-email" class="form-label fw-bold text-navy">Email Address</label>
                                <input type="email" class="form-control rounded-3 py-2.5" id="feedback-email" placeholder="Enter your email" required>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="feedback-role" class="form-label fw-bold text-navy">Stakeholder Category</label>
                                <select class="form-select rounded-3 py-2.5" id="feedback-role" required>
                                    <option value="" disabled selected>Select category</option>
                                    <option value="student">Current Student</option>
                                    <option value="faculty">Faculty Member</option>
                                    <option value="alumni">Alumnus/Alumna</option>
                                    <option value="employer">Employer / Recruiter</option>
                                    <option value="parent">Parent</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="feedback-type" class="form-label fw-bold text-navy">Feedback Area</label>
                                <select class="form-select rounded-3 py-2.5" id="feedback-type" required>
                                    <option value="" disabled selected>Select area</option>
                                    <option value="academics">Academics & Syllabus</option>
                                    <option value="infrastructure">Infrastructure & Labs</option>
                                    <option value="placements">Training & Placements</option>
                                    <option value="library">Library & Digital Resources</option>
                                    <option value="canteen">Canteen & Hostels</option>
                                    <option value="other">General Administration</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-bold text-navy d-block">Overall Satisfaction Level</label>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="satisfaction" id="sat-excellent" value="excellent" checked>
                                    <label class="form-check-label small" for="sat-excellent">Excellent</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="satisfaction" id="sat-good" value="good">
                                    <label class="form-check-label small" for="sat-good">Good</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="satisfaction" id="sat-satisfactory" value="satisfactory">
                                    <label class="form-check-label small" for="sat-satisfactory">Satisfactory</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="satisfaction" id="sat-needs-improvement" value="needs-improvement">
                                    <label class="form-check-label small" for="sat-needs-improvement">Needs Improvement</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="feedback-comments" class="form-label fw-bold text-navy">Suggestions / Comments</label>
                            <textarea class="form-control rounded-3" id="feedback-comments" rows="5" placeholder="Write your detailed suggestions here..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary py-2.5 rounded-3 fw-bold text-uppercase tracking-wider shadow-sm mt-2" style="background-color: #0B3D91 !important; border-color: #0B3D91 !important;">
                            Submit Feedback <i class="bi bi-send-fill ms-1"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

