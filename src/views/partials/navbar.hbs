<!-- Tier 3.5: Latest Updates Scrolling Ticker (Below Primary Navigation Bar) -->
<div class="latest-updates-ticker py-1 text-dark border-bottom" style="background-color: #FFF9E6; font-family: 'Inter', sans-serif; font-size: 12px; height: 32px; display: flex; align-items: center; overflow: hidden; border-color: rgba(249, 168, 38, 0.25) !important;">
    <div class="container-fluid px-lg-4 d-flex align-items-center w-100 h-100">
        <!-- Title Badge -->
        <span class="badge text-white px-3 py-1 me-3 rounded-1 text-uppercase tracking-wider fw-bold text-nowrap d-flex align-items-center gap-1 shadow-sm" style="background-color: #7A0016; font-size: 10px; height: 22px; font-family: 'Plus Jakarta Sans', sans-serif;">
            <span class="spinner-grow spinner-grow-sm text-warning" style="width: 6px; height: 6px;" role="status"></span> Updates
        </span>
        <!-- Ticker Marquee Container -->
        <div class="ticker-marquee-wrapper flex-grow-1 overflow-hidden h-100 d-flex align-items-center">
            <marquee id="latest-updates-marquee" scrollamount="4" onmouseover="this.stop();" onmouseout="this.start();" class="w-100 fw-bold text-navy" style="margin: 0; color: #0B3D91 !important;">
                Loading live announcements and circulars...
            </marquee>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const marqueeEl = document.getElementById('latest-updates-marquee');
        if (marqueeEl) {
            fetch('/api/news')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.news && data.news.length > 0) {
                        const scrollingText = data.news.map(item => {
                            let link = '/news';
                            if (item.category === 'admissions') link = '/admissions';
                            else if (item.category === 'placement') link = '/placements';
                            return `<span class="me-5 text-navy fw-bold"><i class="bi bi-megaphone-fill text-warning me-1"></i> [${item.category.toUpperCase()}] <a href="${link}" class="text-navy text-decoration-none hover-text-danger">${item.title}</a></span>`;
                        }).join(' <span class="mx-3 text-muted">•</span> ');
                        marqueeEl.innerHTML = scrollingText;
                    } else {
                        marqueeEl.innerHTML = 'Welcome to AGM Rural College of Engineering & Technology (AGMRCET) Varur, Hubballi.';
                    }
                })
                .catch(() => {
                    marqueeEl.innerHTML = 'Welcome to AGM Rural College of Engineering & Technology (AGMRCET) Varur, Hubballi.';
                });
        }
    });
</script>

